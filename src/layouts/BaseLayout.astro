---
import '../styles/global.css';
import { portfolio } from '../data/portfolio';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content={portfolio.description}/>
  <meta property="og:title" content={title + ' — ' + portfolio.name}/>
  <meta property="og:description" content={portfolio.description}/>
  <meta property="og:type" content="website"/>
  <title>{title} — {portfolio.name}</title>
  <script is:inline>
    try {
      const saved = localStorage.getItem('fp-theme') || localStorage.getItem('portfolio-theme');
      document.documentElement.classList.toggle('dark', saved === 'dark');
    } catch {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <slot/>
  <script>
    const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    function syncTheme() {
      const dark = document.documentElement.classList.contains('dark');
      toggle?.setAttribute('aria-pressed', String(dark));
      const label = toggle?.querySelector('span');
      if (label) label.textContent = dark ? 'Light mode' : 'Dark mode';
    }
    syncTheme();
    toggle?.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('fp-theme', dark ? 'dark' : 'light'); } catch {}
      syncTheme();
    });
  </script>
</body>
</html>
