---
import { Image } from 'astro:assets';
import craftsmanship from '../assets/craftsmanship-scene-v2.png';
import architecture from '../assets/architecture-covers.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcon from '../components/SocialIcon.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { portfolio } from '../data/portfolio';
const navigation = [{ label: 'Home', href: '#home' }, { label: 'Experience', href: '#experience' }, { label: 'Projects', href: '#case-studies' }, { label: 'About', href: '#summary' }, { label: 'Contact', href: '#contact' }];
---
<BaseLayout>
  <div class="architectural-backdrop" aria-hidden="true"></div>
  <header class="site-header page-width">
    <a href="#home" class="brand-mark" aria-label={portfolio.name + ', home'}>{portfolio.initials}</a>
    <nav aria-label="Portfolio sections" class="section-nav">{navigation.map((item, index) => <a class:list={[{ 'home-link': index === 0 }]} href={item.href}>{item.label}</a>)}</nav>
    <div class="header-actions">
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch color theme" aria-pressed="false">
        <span class="theme-sun" aria-hidden="true">☼</span>
        <svg class="theme-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"/></svg>
      </button>
      <a class="btn primary-button header-contact" href="#contact">Let’s connect <span aria-hidden="true">→</span></a>
    </div>
  </header>
  <div id="home" class="page-width portfolio-grid">
    <aside id="profile" class="profile glass-panel" aria-label="Profile">
      <div class="avatar">
        {portfolio.portrait ? <img src={portfolio.portrait} alt={portfolio.name} width="198" height="198" /> : <span class="avatar-placeholder" aria-label="Portrait placeholder">{portfolio.initials}</span>}
      </div>
      <h1>{portfolio.name}</h1>
      <p class="profile-role">{portfolio.role}</p>
      <div class="profile-divider"></div>
      <p class="profile-location"><svg width="15" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7Zm0 10a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"/></svg>{portfolio.location}</p>
      <p class="profile-introduction">{portfolio.introduction}</p>
      <div class="profile-socials" aria-label="Social links">{portfolio.contact.socials.map(social => social.href ? <a href={social.href} aria-label={social.label}><SocialIcon name={social.label}/></a> : <span aria-label={social.label + ' link not supplied'} title={social.label + ' link not supplied'}><SocialIcon name={social.label}/></span>)}{portfolio.contact.email ? <a href={'mailto:' + portfolio.contact.email} aria-label="Email"><SocialIcon name="Email"/></a> : <span aria-label="Email not supplied" title="Email not supplied"><SocialIcon name="Email"/></span>}</div>
      <a class="btn primary-button profile-connect" href="#contact">Let’s connect <span aria-hidden="true">→</span></a>
      <div class="profile-status"><span class="status-dot" aria-hidden="true"></span><div><p>{portfolio.availability}</p><p class="muted">{portfolio.sidebarNote}</p></div></div>
      <blockquote class="profile-quote"><span aria-hidden="true">“</span><p>“{portfolio.personalMotto}”</p><i aria-hidden="true"></i></blockquote>
    </aside>
    <main id="main">
      <section class="hero-section" aria-labelledby="hero-heading">
        <figure class="hero-art"><Image src={craftsmanship} alt={portfolio.hero.imageAlt} widths={[640, 960, 1280]} sizes="(max-width: 700px) 95vw, 620px" width={960} format="webp" loading="eager" fetchpriority="high" /></figure>
        <div class="hero-art-label" aria-hidden="true">Data<br/>Insights<br/>Opportunities<span></span></div>
        <div class="hero-copy">
          <p class="eyebrow">{portfolio.hero.eyebrow}</p>
          <h2 id="hero-heading">{portfolio.hero.heading}<br/> <span>{portfolio.hero.emphasis}</span></h2>
          <p class="hero-description">{portfolio.hero.description}</p>
          <div class="hero-actions"><a class="btn primary-button" href="#case-studies">View my work <span aria-hidden="true">→</span></a>{portfolio.resume ? <a class="btn secondary-button" href={portfolio.resume} download>Download CV <span aria-hidden="true">↓</span></a> : <span class="btn secondary-button unavailable" aria-disabled="true">CV to be added <span aria-hidden="true">↓</span></span>}</div>
        </div>
        <div class="metrics" aria-label="Professional metrics">{portfolio.metrics.map(metric => <div class="metric" title={metric.confirmed ? undefined : 'Placeholder — value not supplied'}><span class="metric-value">{metric.value}</span><p>{metric.label}<br/>{metric.detail}</p>{!metric.confirmed && <span class="sr-only">Value not yet supplied</span>}</div>)}</div>
      </section>
      <section id="case-studies" class="featured-section">
        <div class="section-heading"><h2>Analytics Case Studies</h2><a class="view-link" href="#case-study-details">View details <span aria-hidden="true">→</span></a></div>
        <div class="project-grid">
          {(portfolio.caseStudies.length ? portfolio.caseStudies.slice(0, 3).map(study => ({ category: study.category, title: study.title, description: study.summary, tools: study.tools.join(' · '), placeholder: false })) : portfolio.projectPlaceholders.map(item => ({ ...item, placeholder: true }))).map((project, index) => <article class="project-card glass-panel">
            <div class="project-cover"><Image src={architecture} alt="" width={1200} format="webp" loading="lazy" style={'left: ' + index * -100 + '%'} /><span class="project-category">{project.category}</span></div>
            <div class="project-body"><h3>{project.title}</h3><p>{project.description}</p><div class="project-footer"><span>{project.placeholder ? 'Placeholder · ' : ''}{project.tools}</span><a class="round-arrow" href="#case-study-details" aria-label={'Details for ' + project.title}>→</a></div></div>
          </article>)}
        </div>
      </section>
      <section id="experience" class="experience-section">
        <div class="section-heading"><h2>Professional Experience</h2><a class="view-link" href="#experience-details">View details <span aria-hidden="true">→</span></a></div>
        <div class="experience-rows">{portfolio.experience.map((job, index) => <a class="experience-row glass-panel" href={'#experience-' + index}>
          <span class="experience-icon" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V3h8v4M3 12h18M10 11v4h4v-4"/></svg></span>
          <span class="experience-name"><strong>{job.role}</strong><span>{job.company}</span></span><span class="experience-meta">{job.period}<br/>{job.location}</span><span class="row-arrow" aria-hidden="true">›</span>
        </a>)}</div>
      </section>
      <section id="summary" class="section-block">
        <div class="section-heading"><h2>Professional Summary</h2></div><div class="prose">{portfolio.summary.map(paragraph => <p>{paragraph}</p>)}</div>
        <div class="focus-note glass-panel"><strong>Current focus</strong><p>{portfolio.currentFocus}</p></div>
      </section>
      <section id="capabilities" class="section-block"><div class="section-heading"><h2>Core Capabilities</h2></div><div class="capability-grid">{portfolio.capabilities.map(item => <article class="capability glass-panel"><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></section>
      <section id="analytics-skills" class="section-block"><div class="section-heading"><h2>Data & Analytics Skills</h2></div><p class="section-intro">{portfolio.analytics.introduction}</p><div class="skill-groups">{portfolio.analytics.groups.map(group => <div class="skill-row"><h3>{group.category}</h3><div class="skill-badges">{group.items.map(skill => <span class="badge">{skill}</span>)}</div></div>)}</div></section>
      <section id="case-study-details" class="section-block"><div class="section-heading"><h2>Case Study Details</h2></div>{portfolio.caseStudies.length ? <div class="case-study-list">{portfolio.caseStudies.map(study => <CaseStudyCard study={study}/>)}</div> : <div class="case-study glass-panel"><h3>{portfolio.caseStudySection.emptyTitle}</h3><p class="section-intro">{portfolio.caseStudySection.emptyDescription}</p><div class="skill-badges">{portfolio.caseStudySection.areas.map(area => <span class="badge">{area}</span>)}</div></div>}</section>
      <section id="experience-details" class="section-block"><div class="section-heading"><h2>Experience Details</h2></div><p class="section-intro">{portfolio.experienceNote}</p><div class="experience-details">{portfolio.experience.map((job, index) => <article id={'experience-' + index} class="case-study glass-panel"><h3>{job.role}</h3><p class="section-intro">{job.description}</p><ul>{job.highlights.map(item => <li>{item}</li>)}</ul></article>)}</div></section>
      <section id="education" class="section-block"><div class="section-heading"><h2>Education & Certifications</h2></div>{portfolio.education.map(item => <article class="education-card"><h3>{item.qualification}</h3><p>{item.institution} · {item.period}</p><p>{item.status}</p><p>{item.detail}</p></article>)}<div class="certificates">{portfolio.certifications.map(item => <article class="certificate glass-panel"><h3>{item.href ? <a href={item.href}>{item.name} ↗</a> : item.name}</h3><p>{item.issuer} · {item.year}</p></article>)}</div></section>
      <section id="contact" class="contact-card glass-panel"><h2>Contact</h2><h3>{portfolio.contact.heading}</h3><p>{portfolio.contact.description}</p>{portfolio.contact.email ? <a class="btn primary-button" href={'mailto:' + portfolio.contact.email}>Say hello →</a> : <p>{portfolio.contact.emailPlaceholder}</p>}<div class="contact-socials">{portfolio.contact.socials.map(social => social.href ? <a href={social.href}>{social.label} ↗</a> : <span>{social.label} · link to be added</span>)}</div></section>
    </main>
  </div>
  <footer class="page-width footer-row"><p>© {new Date().getFullYear()} {portfolio.name}</p><p>{portfolio.footer}</p><a href="#home">Back to top ↑</a></footer>
</BaseLayout>
