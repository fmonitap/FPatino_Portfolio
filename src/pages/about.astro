---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ResumeLink from '../components/ResumeLink.astro';
import ContactDraft from '../components/ContactDraft.astro';
import { portfolio } from '../data/portfolio';
---
<SiteLayout title="Profile">
<PageIntro label="Profile" description="My background, professional experience and the ways to get in touch.">Commercial experience.<br/>An analytical perspective.</PageIntro>
<nav class="profile-sections" aria-label="Profile sections"><a href="#background">Background</a><a href="#experience">Experience</a><a href="#education">Education</a><a href="#contact">Contact</a></nav>
<section id="background" class="about-layout page-content"><div><h2>Building on experience.</h2>{portfolio.summary.map(paragraph => <p>{paragraph}</p>)}</div><aside class="about-aside"><div class="eyebrow">The connecting thread</div><h3>Commercial context</h3><p>Understand the decision before choosing the analysis.</p><h3>Analytical curiosity</h3><p>Ask what the evidence supports — and what it does not.</p><h3>Practical relevance</h3><p>Bring the insight back to the business question.</p></aside></section>
<section class="content-section"><h2>Capabilities &amp; tools</h2>{portfolio.capabilities.map(item => <article class="content-row"><h3>{item.title}</h3><p>{item.description}</p></article>)}{portfolio.analytics.groups.map(group => <article class="content-row"><h3>{group.category}</h3><p>{group.items.join(' · ')}</p></article>)}</section>
<section id="education" class="content-section"><h2>Education</h2>{portfolio.education.map(item => <article class="content-row"><h3>{item.qualification}</h3><p>{item.institution} · {item.period}</p><p>{item.status}</p><p>{item.detail}</p></article>)}</section>
<section class="content-section"><h2>Certifications</h2>{portfolio.certifications.map(item => <article class="content-row"><h3>{item.href ? <a class="text-link" href={item.href}>{item.name} ↗</a> : item.name}</h3><p>{item.issuer} · {item.year}</p></article>)}</section>
<section id="experience" class="profile-experience page-content"><div class="section-head"><h2>Professional experience</h2></div>{portfolio.experience.map(job => <article class="experience-row" id={job.role === 'Business Development Officer' ? 'network-planning' : undefined}><div class="role-meta"><span>{job.period}</span><p>{job.location}</p></div><div><h2>{job.role}</h2><h3>{job.company}</h3><p>{job.description}</p><ul>{job.highlights.map(highlight => <li>{highlight}</li>)}</ul></div></article>)}<p class="note">{portfolio.experienceNote}</p></section>
<section id="contact" class="contact-layout profile-contact"><div class="contact-status"><div class="eyebrow">Get in touch</div><h2>{portfolio.name}</h2><p>{portfolio.location}</p><div class="contact-links"><a class="text-link" href={'mailto:' + portfolio.contact.email}>{portfolio.contact.email}</a><a class="text-link" href={portfolio.contact.phoneHref}>{portfolio.contact.phone}</a>{portfolio.contact.socials.map(social => social.href ? <a class="text-link" href={social.href}>{social.label} ↗</a> : <p>{social.label} · link to be added</p>)}</div><div class="actions"><ResumeLink/></div><p>You can prepare and download a message draft here. Messages are not sent through this site.</p></div><ContactDraft/></section>
</SiteLayout>
