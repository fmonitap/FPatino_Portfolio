---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { portfolio } from '../data/portfolio';
import ContactDraft from '../components/ContactDraft.astro';
import ResumeLink from '../components/ResumeLink.astro';
---
<SiteLayout title="Contact">
<PageIntro label="Contact" description="For conversations about business development, commercial opportunities and business analytics.">Let’s start with<br>a conversation.</PageIntro><section class="contact-layout"><div class="contact-status"><div class="eyebrow">Get in touch</div><h2>{portfolio.name}</h2><p>{portfolio.location}</p><div class="contact-links"><a class="text-link" href={'mailto:' + portfolio.contact.email}>{portfolio.contact.email}</a><a class="text-link" href={portfolio.contact.phoneHref}>{portfolio.contact.phone}</a>{portfolio.contact.socials.map(social => social.href ? <a class="text-link" href={social.href}>{social.label} ↗</a> : <p>{social.label} · link to be added</p>)}</div><div class="actions"><ResumeLink/></div><p>You can prepare and download a message draft here. Messages are not sent through this site.</p></div><ContactDraft/></section>
</SiteLayout>
