---
import { siteUrl } from '../utils/urls';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
---
<SiteLayout title="Projects">
<PageIntro label="Projects" description="A dedicated space for business analytics and commercial work — with the context, evidence and reasoning behind each recommendation.">The question comes first.</PageIntro><section class="page-content"><ProjectGrid/><div class="details"><details><summary>What will each case study include?</summary><p>The business question and its context, the data and approach used, the resulting insight, and a practical recommendation. Outcomes will be included only where they can be supported by evidence.</p></details></div><div class="actions"><a class="text-link" href={siteUrl('/about/')}>Read about my perspective <span aria-hidden="true">↗</span></a></div></section>
</SiteLayout>
