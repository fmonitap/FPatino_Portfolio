---
import { portfolio } from '../data/portfolio';
import CaseStudyCard from './CaseStudyCard.astro';
interface Props { featured?: boolean }
const { featured = false } = Astro.props;
const studies = featured ? portfolio.caseStudies.slice(0, 3) : portfolio.caseStudies;
---
{studies.length ? <div>{studies.map(study => <CaseStudyCard study={study}/>)}</div> : <div class:list={['empty', { 'project-empty': !featured }]}><div><span class="tag">Awaiting project content</span>{featured ? <h3>A space for evidence-led work.</h3> : <h2>Good work deserves the full story.</h2>}<p>{featured ? 'Verified projects and case studies have not yet been added. Each will connect a business question, an approach and a recommendation.' : 'No verified projects or case studies have been supplied yet. This showcase will be populated with genuine work, supported by its sources and limitations.'}</p></div>{featured && <span class="empty-mark" aria-hidden="true">↗</span>}</div>}
